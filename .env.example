# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiweb

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_ID=your_telegram_id

# JWT
