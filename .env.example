# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiweb

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_ID=your_telegram_id

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# App
APP_URL=https://your-domain.up.railway.app
NODE_ENV=production

# AI Provider (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_SITE_URL=https://your-domain.up.railway.app
AI_SITE_NAME=Nexus AI

# AI Model overrides (optional - defaults are set in code)
# AI_MODEL_FAST=google/gemini-2.0-flash-001
# AI_MODEL_SMART=openai/gpt-4o-mini
# AI_MODEL_THINKING=openai/gpt-4o
# AI_MODEL_CREATIVE=anthropic/claude-3.5-sonnet
# AI_MODEL_FOCUS=openai/gpt-4o-mini

# MLBB Checker Provider
# ML_CHECK_PROVIDER=kiosweb
# KIOSWEB_MEMBER_CODE=your_kiosweb_member_code

# Or use Mochigame:
# ML_CHECK_PROVIDER=mochigame
# MOCHIGAME_API_KEY=your_mochigame_api_key
